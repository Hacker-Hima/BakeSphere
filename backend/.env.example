PORT=5000
NODE_ENV=development
JWT_SECRET=bakesphere_super_secret_jwt_key_2026

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your real credentials:
# Example: mongodb+srv://admin:MySecretPass123@cluster0.abcde.mongodb.net/bakesphere?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bakesphere?retryWrites=true&w=majority

# Google Gemini AI Key (Optional: unlocks live Generative AI responses from Gemini 2.0 / 1.5 Flash)
# Get a free key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Email OTP Verification (SMTP)
# To receive OTPs in your actual personal Gmail inbox:
# 1. Enter your Gmail: SMTP_USER=yourname@gmail.com
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your App Password: SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BakeSphere Bakery" <noreply@bakesphere.com>

